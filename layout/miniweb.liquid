<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="miniweb-layout">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#406ef5">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <style>
      html, body { margin: 0; padding: 0; background: #ffffff; }
      body { font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
      .miniweb-layout main { display: block; }

      /* La mini-web tiene su propio USP marquee (.mw-usp) en la section.
         Ocultamos por completo el header-group y el footer del theme — la mini-web
         se renderiza standalone. */
      body.miniweb-body > header:not(.mw-header),
      body.miniweb-body > footer,
      body.miniweb-body > .header,
      body.miniweb-body > .footer,
      body.miniweb-body .shopify-section-header,
      body.miniweb-body .shopify-section-group-header-group,
      body.miniweb-body .shopify-section-group-footer-group {
        display: none !important;
      }

      /* Bloquear widgets / chatbots / cabeceras de apps de terceros que inyectan UI tras cargar */
      body.miniweb-body [id*="hulk" i],
      body.miniweb-body [class*="hulk" i],
      body.miniweb-body [id*="judgeme" i],
      body.miniweb-body [class*="judgeme" i],
      body.miniweb-body [id*="judge-me" i],
      body.miniweb-body [class*="judge-me" i],
      body.miniweb-body [id*="naviplus" i],
      body.miniweb-body [class*="naviplus" i],
      body.miniweb-body [id*="navi-plus" i],
      body.miniweb-body [class*="navi-plus" i],
      body.miniweb-body [class*="naviItem" i],
      body.miniweb-body [class*="STICKY_TABBAR" i],
      body.miniweb-body [class*="navimain_layout" i],
      body.miniweb-body [name="Bottom Bar"],
      body.miniweb-body [name^="Bottom Bar"],
      body.miniweb-body [id^="SF-"],
      body.miniweb-body [id*="easify" i],
      body.miniweb-body [class*="easify" i],
      body.miniweb-body [id*="monster-cart" i],
      body.miniweb-body [class*="monster-cart" i],
      body.miniweb-body [id*="mw-bundle" i],
      body.miniweb-body [class*="mw-bundle" i],
      body.miniweb-body [id*="bundle-builder" i],
      body.miniweb-body [class*="bundle-builder" i],
      body.miniweb-body [id*="launcher_widget" i],
      body.miniweb-body [class*="launcher_widget" i],
      body.miniweb-body [id*="referral_widget" i],
      body.miniweb-body [class*="referral_widget" i],
      body.miniweb-body [id*="jotform" i],
      body.miniweb-body [class*="jotform" i],
      body.miniweb-body [id*="floating" i]:not(.cart-cta):not(.cart-fab),
      body.miniweb-body [class*="floating" i]:not(.cart-cta):not(.cart-fab),
      body.miniweb-body [id*="chat-widget" i],
      body.miniweb-body [class*="chat-widget" i],
      body.miniweb-body [id*="chatbot" i],
      body.miniweb-body [class*="chatbot" i],
      body.miniweb-body iframe[src*="shopify.com/extensions"]:not([src*="loader"]),
      body.miniweb-body iframe[src*="naviplus"],
      body.miniweb-body iframe[src*="flov.b-cdn"],
      body.miniweb-body iframe[src*="judgeme"],
      body.miniweb-body iframe[src*="jotform"] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
      }

      /* Skip-to-content link oculto visualmente pero accesible */
      .skip-to-content-link {
        position: absolute; left: -9999px;
        width: 1px; height: 1px;
        overflow: hidden;
      }
      .skip-to-content-link:focus {
        left: auto; width: auto; height: auto;
        padding: 8px 16px; background: #000; color: #fff;
        z-index: 9999;
      }
    </style>

    {{ content_for_header }}

    <script>
      /* Eliminar agresivamente widgets de terceros inyectados por JS */
      (function () {
        var WIDGET_SELECTORS = [
          '[id*="hulk" i]',
          '[class*="hulk" i]',
          '[id*="judgeme" i]:not(.miniweb-app *)',
          '[class*="judgeme" i]:not(.miniweb-app *)',
          '[id*="naviplus" i]',
          '[class*="naviplus" i]',
          '[class*="naviItem" i]',
          '[class*="STICKY_TABBAR" i]',
          '[class*="navimain_layout" i]',
          '[name="Bottom Bar"]',
          '[name^="Bottom Bar"]',
          '[id^="SF-"]',
          '[id*="easify" i]:not(.miniweb-app *)',
          '[class*="easify" i]:not(.miniweb-app *)',
          '[id*="monster-cart" i]',
          '[class*="monster-cart" i]',
          '[id*="mw-bundle" i]',
          '[class*="mw-bundle" i]',
          '[id*="bundle-builder" i]:not(.miniweb-app *)',
          '[class*="bundle-builder" i]:not(.miniweb-app *)',
          '[id*="launcher_widget" i]',
          '[class*="launcher_widget" i]',
          '[id*="referral_widget" i]',
          '[class*="referral_widget" i]',
          '[id*="jotform" i]',
          '[class*="jotform" i]',
          '[id*="chat-widget" i]',
          '[class*="chat-widget" i]',
          '[id*="chatbot" i]',
          '[class*="chatbot" i]',
          'iframe[src*="naviplus"]',
          'iframe[src*="flov.b-cdn"]',
          'iframe[src*="judgeme"]',
          'iframe[src*="jotform"]'
        ];
        function purge() {
          for (var i = 0; i < WIDGET_SELECTORS.length; i++) {
            var nodes = document.querySelectorAll(WIDGET_SELECTORS[i]);
            for (var j = 0; j < nodes.length; j++) {
              var n = nodes[j];
              if (n && n.parentNode && !n.closest('.miniweb-app')) {
                n.parentNode.removeChild(n);
              }
            }
          }
        }
        // Purge ahora y al DOMContentLoaded, después observar mutaciones
        purge();
        document.addEventListener('DOMContentLoaded', purge);
        if (typeof MutationObserver !== 'undefined') {
          new MutationObserver(function () { purge(); })
            .observe(document.documentElement, { childList: true, subtree: true });
        }
        // Failsafe extra ticks
        setTimeout(purge, 500);
        setTimeout(purge, 1500);
        setTimeout(purge, 3000);
      })();
    </script>
  </head>

  <body class="miniweb-body template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">
    <main id="MainContent" class="miniweb-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
