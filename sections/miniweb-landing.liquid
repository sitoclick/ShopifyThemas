{% comment %}
  MINIWEB · Monjamón y Más
  Página única tipo Glovo con 6 categorías top-level + sub-niveles solo en Loncheados.
  Filtro Calidad transversal. Mini-header propio (logo + carrito). Sin footer del theme.
  - Asignar a Page con template = miniweb (layout = miniweb).
  - CSS y JS en assets/miniweb-landing.css + miniweb-landing.js
  - Reutiliza iconos sobres-*.svg ya subidos al theme.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Bebas+Neue&display=swap" rel="stylesheet">
{{ 'miniweb-landing.css' | asset_url | stylesheet_tag }}

<div class="miniweb-app">

  <!-- Mini-header propio: azul, logo monja + wordmark MONJAMÓN + carrito -->
  <header class="mw-header">
    <a class="mw-header__brand" href="{{ routes.root_url }}" aria-label="Inicio" data-confirm-exit="true">
      <span class="mw-header__logo" aria-hidden="true">
        <img src="https://www.monjamonymas.com/cdn/shop/files/nuevoflavicon_c9223ef1-f146-48a0-8c22-7cb86351b048.svg?v=1753271575&width=180" alt="" loading="eager" />
      </span>
      <span class="mw-header__name">MONJAMÓN</span>
    </a>
    <button type="button" class="mw-header__cart" id="mwCartBtn" aria-label="Ver cesta">
      <img class="mw-header__cart-icon" src="https://www.monjamonymas.com/cdn/shop/files/cesta.svg" alt="" aria-hidden="true" loading="eager" />
      <span class="mw-header__cart-label">Cesta</span>
      <span class="mw-header__count" id="mwCartCount" hidden>0</span>
    </button>
  </header>

  <div class="app">

    <!-- Chips top-level (6 categorías) -->
    <nav class="chips chips--top" id="chipsTop" aria-label="Categorías">
      <button class="chip is-active" data-cat="loncheados">Loncheados</button>
      <button class="chip" data-cat="jamones-paletas">Jamones y Paletas</button>
      <button class="chip" data-cat="embutidos">Embutidos</button>
      <button class="chip" data-cat="quesos">Quesos</button>
      <button class="chip" data-cat="vinos">Vinos</button>
      <button class="chip" data-cat="otros">Otros</button>
    </nav>

    <!-- Chips sub-level (solo Loncheados) -->
    <nav class="chips chips--sub" id="chipsSub" aria-label="Subcategorías de Loncheados">
      <button class="chip is-active" data-sub="all">Todos</button>
      <button class="chip" data-sub="jamon">Jamón</button>
      <button class="chip" data-sub="paleta">Paleta</button>
      <button class="chip" data-sub="embutido">Embutido</button>
    </nav>

    <!-- Toolbar: Filtros + Lupa -->
    <div class="toolbar">
      <button class="filterbar__btn" id="filterToggle">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
        <span>Filtros</span>
        <span class="filterbar__count" id="filterCount" hidden>0</span>
        <svg class="filterbar__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="search-pill" id="searchPill">
        <button class="search-pill__toggle" id="searchToggle" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <input id="searchInput" type="search" placeholder="Buscar..." autocomplete="off" />
        <button class="search-pill__clear" id="searchClear" aria-label="Cerrar">×</button>
      </div>
    </div>
    <div class="fpanel" id="filterPanel" hidden></div>
    <div class="fpanel-foot" id="filterFoot" hidden>
      <button class="btn btn--ghost" id="filterClear">Limpiar</button>
      <button class="btn btn--primary" id="filterApply">Aplicar</button>
    </div>

    <main class="main">
      <section class="section">
        <header class="section__head">
          <div>
            <p class="section__eyebrow" id="sectionEyebrow">{{ section.settings.eyebrow | default: 'Loncheados al instante' }}</p>
            <h2 class="section__title" id="sectionTitle">{{ section.settings.title | default: 'Cae en la tentación' }}</h2>
          </div>
          <span class="section__sub" id="resultCount">— productos</span>
        </header>
        <div class="list" id="list"></div>
        <div class="empty" id="emptyState" hidden>
          <p class="empty__txt">No hay productos con esos filtros</p>
          <button class="btn btn--ghost" id="emptyReset">Limpiar todo</button>
        </div>
        <div class="soon" id="soonState" hidden>
          <p class="soon__emoji">🍖</p>
          <p class="soon__title">Próximamente</p>
          <p class="soon__txt">Estamos preparando esta categoría con mimo. Vuelve pronto.</p>
        </div>
      </section>

      <!-- Acordeones de contenido -->
      <section class="acc-block">
        <details class="acc">
          <summary class="acc__head">
            <span class="acc__title">🙏 Sobre Monjamón</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__body">
            <p><strong>Una marca con +100 años de historia y 0 ganas de aburrirte.</strong></p>
            <p>Monjamón nace en 2023 de la mano de <strong>Álex Fernández</strong>, 4ª generación de <strong>Don Ibérico</strong>, una familia de Guijuelo (Salamanca, DOP Guijuelo) que lleva más de un siglo elaborando jamón ibérico de bellota.</p>
            <p>Lo nuestro es <strong>tradición artesanal</strong> hecha desde la dehesa: cerdos en libertad, alimentación natural, curaciones largas (+42 meses) y mimo en cada paso. Pero contado con humor, sin solemnidad ni pijerías 😎.</p>
            <p>Aquí manda <strong>Sor Ibérica</strong>, nuestra monja virtual: ella escribe, atiende, predica el ibérico y te resuelve dudas con cariño. Es la cara visible del Convento.</p>
            <p><strong>🏆 Reconocimientos:</strong></p>
            <ul>
              <li><strong>Producto del Año 2025</strong> · Gran Premio a la Innovación</li>
              <li><strong>Superior Taste Award 2023</strong> · 3 estrellas (máxima)</li>
              <li><strong>4,9 / 5</strong> en +951 reseñas verificadas</li>
              <li>DOP Guijuelo · Calicer ENAC · Bienestar Animal</li>
            </ul>
            <p><strong>📦 Cómo trabajamos:</strong></p>
            <ul>
              <li>Pequeñas cañadas de cerdos con <strong>ganaderos locales</strong></li>
              <li><strong>Secaderos propios</strong> en Guijuelo</li>
              <li>Trabajo <strong>artesanal</strong> con equipo pequeño</li>
              <li>Atención personal <strong>REAL</strong></li>
            </ul>
            <p class="acc__claim">«¡A un click del milagro!» 🕯️</p>
          </div>
        </details>

        <details class="acc">
          <summary class="acc__head">
            <span class="acc__title">✨ El Arte de un Jamón Verdaderamente Artesano</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__body acc__body--long">
            <p class="acc__lede"><em>Spoiler: no se hace en dos tardes ni con prisas.</em></p>
            <p>En Monjamón no hablamos de jamón... <strong>lo veneramos</strong>. Y no, no es exageración. Aquí no hay trucos, ni humos, ni milagros de supermercado. Solo bellotas de las buenas, tiempo sin reloj y un cariño que ni en las bodas gitanas.</p>
            <p>Porque sí, del cerdo hasta los andares, claro que sí... pero mejor si <strong>anda suelto por la dehesa</strong>, comiendo bellotas como si no hubiera un mañana y sin estrés (que eso da sabor… y seguro que engorda 🐷).</p>
            <p>Te contamos cómo lo hacemos. Tiene más pasos que la KALLAX que compraste el año pasado, pero todos merecen la pena:</p>

            <h4 class="acc__step">1. Ganaderos centenarios &amp; bellotas que valen oro 🌳</h4>
            <p>Trabajamos con familias que llevan <strong>más de 100 años</strong> criando cerdos ibéricos. ¡Más experiencia que Sor Amparo dando consejos de amor! Los animales andan sueltos por el campo, se echan sus buenas siestas a la sombra y meriendan bellotas como marqueses.</p>
            <p>Hacemos <strong>análisis de ácidos oleicos</strong> (que suena a invento del Profesor Bacterio) solo para confirmar que el cerdito ha comido como Dios manda. ¿Resultado? Una grasa infiltrada que se funde en boca más rápido que tú en el sofá después de comer.</p>

            <h4 class="acc__step">2. Salazón tradicional, con vuelta y todo 🧂</h4>
            <p>Aquí no tiramos el jamón en sal y nos olvidamos. Lo colocamos a mano en pilas de sal marina, como quien mete a su bebé en el agua bendita. Y a mitad de proceso, les damos la vuelta uno por uno (que esto no es el lavavajillas, cariño 😉).</p>
            <p>¿Para qué? Para que el salado quede parejito, jugoso, ni soso ni salaíllo. Como esa tortilla que te sale perfecta cuando estás de buen humor.</p>

            <h4 class="acc__step">3. Curación natural: abrir, cerrar, oler, bendecir 🍃</h4>
            <p>¡Ay, este paso! Aquí es donde el jamón se transforma. Nuestros secaderos no son modernos ni tienen botones de colores. Son <strong>salas grandes con ventanas</strong> que abrimos y cerramos a mano para controlar temperatura, humedad y espíritu santo si hace falta.</p>
            <p>Ni aire acondicionado, ni calorcillos trampa: solo el viento, las estaciones y la intuición del maestro que dice "hoy se abre que no hay mucha humedad". Porque un jamón que no respira, no enamora. Y el nuestro… madre mía, huele que da ganas de escribirle poemas.</p>

            <h4 class="acc__step">4. Mantenimiento semestral, nivel monjil 🕯️</h4>
            <p>Cada seis meses, venga llueva, truene o haya fiesta patronal, nos metemos en bodega y revisamos los jamones uno a uno. Los hidratamos con una fina capa de aceite y manteca para que respiren con tranquilidad y les revisamos hasta el aura.</p>
            <p>Porque aquí el jamón no se deja solo a su suerte. Se acompaña como a un buen amigo después de un Sábado Santo.</p>

            <h4 class="acc__step">5. Calado final: aquí solo pasa el que enamora 🎯</h4>
            <p>Antes de ponerle la vitola Monjamón (esa etiqueta que dice "aquí hay fantasía ibérica"), llega el momento del <strong>calado</strong>. Una aguja de hueso entra en el jamón (suave, sin dolor, como quien reza bajito), y el maestro <em>mira, toca y huele</em>.</p>
            <p>Si lo que sale de ahí no es gloria bendita... se sigue curando, o se envía al cielo de los jamones si es necesario. <strong>Aquí no hay aprobados por compasión.</strong> O es celestial, o no nos vale.</p>

            <h4 class="acc__step">¿Y qué te llega a ti? 🏆</h4>
            <p>Un jamón que parece sacado de una novela. Uno de los que ya no quedan. Con historia, con alma, con esa grasa que brilla como la frente de un bebé y ese aroma que te hace cerrar los ojos sin querer.</p>
            <p><strong>Un jamón ibérico de verdad</strong>, sin fuegos artificiales, pero con todo el sabor del mundo.</p>
            <p>Porque en Monjamón no nos andamos con tonterías. <strong>Si lo hacemos, lo hacemos bien.</strong> Y si te lo llevas a casa… prepárate para que hasta el perro del vecino venga a pedirte una lonchita 🐕.</p>
          </div>
        </details>
      </section>

      <!-- Trust badges (iconos brand de Monjamón) -->
      <section class="trust">
        <div class="trust__item">
          <img class="trust__icon" src="https://www.monjamonymas.com/cdn/shop/files/envio.svg" alt="" aria-hidden="true" loading="lazy" />
          <strong class="trust__title">Envíos Gratis</strong>
          <span class="trust__sub">Pedidos +49€ · Península, Baleares y Portugal</span>
        </div>
        <div class="trust__item">
          <img class="trust__icon" src="https://www.monjamonymas.com/cdn/shop/files/Component_3.svg" alt="" aria-hidden="true" loading="lazy" />
          <strong class="trust__title">Pago Seguro</strong>
          <span class="trust__sub">Tarjeta · Bizum · PayPal · Klarna · Contrareembolso</span>
        </div>
        <a class="trust__item" href="https://wa.me/34900433404" target="_blank" rel="noopener">
          <img class="trust__icon" src="https://www.monjamonymas.com/cdn/shop/files/atencion_personalizada.svg" alt="" aria-hidden="true" loading="lazy" />
          <strong class="trust__title">Atención Personalizada</strong>
          <span class="trust__sub">WhatsApp 900 433 404</span>
        </a>
        <a class="trust__item" href="https://whatsapp.com/channel/0029VaD0L3lIXnllqEES1p3a" target="_blank" rel="noopener">
          <img class="trust__icon" src="https://www.monjamonymas.com/cdn/shop/files/novedades.svg" alt="" aria-hidden="true" loading="lazy" />
          <strong class="trust__title">Síguenos</strong>
          <span class="trust__sub">Canal WhatsApp · novedades y ofertas</span>
        </a>
      </section>

      <div class="spacer-cta"></div>
    </main>

  </div>

  <!-- Modal: confirmar salida a la web completa -->
  <div class="exit-modal" id="exitModal" hidden aria-hidden="true">
    <div class="exit-modal__backdrop" data-close></div>
    <div class="exit-modal__panel" role="dialog" aria-modal="true" aria-labelledby="exitModalTitle">
      <span class="exit-modal__icon" aria-hidden="true">🚪</span>
      <h3 class="exit-modal__title" id="exitModalTitle">¿Quieres visitar la web completa?</h3>
      <p class="exit-modal__sub">Vas a salir de la Mini-web de Monjamón y abrir el sitio principal.</p>
      <div class="exit-modal__actions">
        <button type="button" class="btn btn--ghost" data-close>NO, me quedo aquí</button>
        <a class="btn btn--primary" id="exitConfirm" href="/" rel="noopener">SÍ, llévame allá</a>
      </div>
    </div>
  </div>

  <!-- Cart drawer — slide-up con lista de productos + total -->
  <div class="cart-drawer" id="cartDrawer" hidden aria-hidden="true">
    <div class="cart-drawer__backdrop" data-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cartDrawerTitle">
      <button class="cart-drawer__close" data-close aria-label="Cerrar">×</button>
      <header class="cart-drawer__head">
        <h3 class="cart-drawer__title" id="cartDrawerTitle">Tu surtido a medida</h3>
        <span class="cart-drawer__total" id="cartDrawerTotal">0,00 €</span>
      </header>
      <div class="cart-drawer__list" id="cartDrawerList"></div>
      <button class="btn btn--primary btn--block cart-drawer__checkout" id="cartCheckout" type="button">
        <span>IR AL CARRITO</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <div class="sheet" id="sheet" hidden aria-hidden="true">
    <div class="sheet__backdrop" data-close></div>
    <div class="sheet__panel" role="dialog" aria-modal="true">
      <button class="sheet__close" data-close aria-label="Cerrar">×</button>
      <div class="sheet__body" id="sheetBody"></div>
      <footer class="sheet__foot">
        <div class="qty" id="sheetQty">
          <button class="qty__btn" data-q="-1" aria-label="Restar">−</button>
          <span class="qty__val">1</span>
          <button class="qty__btn" data-q="+1" aria-label="Sumar">+</button>
        </div>
        <button class="btn btn--primary btn--block" id="sheetAdd">
          <span>Añadir</span>
          <span id="sheetTotal" class="btn__total">0,00 €</span>
        </button>
      </footer>
    </div>
  </div>
</div>

<script>
  // URLs de assets resueltas por Liquid (Shopify CDN) — reutilizamos los sobres-*.svg ya en theme.
  window.MW_ASSETS = {
    'jamon-bellota'  : "{{ 'sobres-jamon-bellota.svg'   | asset_url }}",
    'paleta'         : "{{ 'sobres-paleta.svg'          | asset_url }}",
    'pasion'         : "{{ 'sobres-pasion.svg'          | asset_url }}",
    'gran-reserva'   : "{{ 'sobres-gran-reserva.svg'    | asset_url }}",
    'lomonasterio'   : "{{ 'sobres-lomonasterio.svg'    | asset_url }}",
    'salchichon'     : "{{ 'sobres-salchichon.svg'      | asset_url }}",
    'esencial'       : "{{ 'sobres-esencial.svg'        | asset_url }}",
    'gourmet'        : "{{ 'sobres-gourmet.svg'         | asset_url }}",
    'premium'        : "{{ 'sobres-premium.svg'         | asset_url }}",
    'mas-vendido'    : "{{ 'sobres-mas-vendido.svg'     | asset_url }}",
    'novedad'        : "{{ 'sobres-novedad.svg'         | asset_url }}",
    'oferta'         : "{{ 'sobres-oferta.svg'          | asset_url }}",
    'top'            : "{{ 'sobres-top.svg'             | asset_url }}",
    'regalo'         : "{{ 'sobres-regalo.svg'          | asset_url }}",
    'meses-30'       : "{{ 'sobres-meses-30.svg'        | asset_url }}",
    'meses-36'       : "{{ 'sobres-meses-36.svg'        | asset_url }}",
    'meses-42'       : "{{ 'sobres-meses-42.svg'        | asset_url }}",
    'meses-50'       : "{{ 'sobres-meses-50.svg'        | asset_url }}",
    'alim-bellota'   : "{{ 'sobres-alim-bellota.svg'    | asset_url }}",
    'alim-pienso'    : "{{ 'sobres-alim-pienso.svg'     | asset_url }}",
    'corte-cuchillo' : "{{ 'sobres-corte-cuchillo.svg'  | asset_url }}",
    'corte-maquina'  : "{{ 'sobres-corte-maquina.svg'   | asset_url }}",
    'vela'           : "{{ 'sobres-vela.svg'            | asset_url }}",
    'choricielo'     : "{{ 'sobres-choricielo.svg'      | asset_url }}",
    'coppa'          : "{{ 'sobres-coppa.svg'           | asset_url }}"
  };

  // Buscador colapsable
  (function() {
    const pill = document.getElementById('searchPill');
    const toggle = document.getElementById('searchToggle');
    const input = document.getElementById('searchInput');
    const clear = document.getElementById('searchClear');
    function open() { pill.classList.add('is-open'); setTimeout(() => input.focus(), 60); }
    function close() {
      pill.classList.remove('is-open');
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      if (pill.classList.contains('is-open')) close(); else open();
    });
    clear.addEventListener('click', (e) => { e.stopPropagation(); close(); });
    document.addEventListener('click', (e) => {
      if (!pill.contains(e.target) && pill.classList.contains('is-open') && !input.value) close();
    });
  })();

  (function() {
    const fp = document.getElementById('filterPanel');
    const ff = document.getElementById('filterFoot');
    new MutationObserver(() => { ff.hidden = fp.hidden; })
      .observe(fp, { attributes: true, attributeFilter: ['hidden'] });
  })();
</script>
{{ 'miniweb-landing.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Mini-web Landing",
  "tag": "section",
  "class": "section-miniweb",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nombre de marca (mini-header)",
      "default": "Monjamón y Más"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow inicial",
      "default": "Loncheados al instante"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título inicial",
      "default": "Cae en la tentación"
    },
    {
      "type": "header",
      "content": "Bloque Sobre Nosotros"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Título",
      "default": "Sobre Monjamón"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Texto",
      "default": "Selección de ibéricos y embutidos artesanos con calidad de convento. Curaciones largas, raza ibérica, alimentación natural. Te lo enviamos a casa loncheado, listo para disfrutar."
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "Link \"Saber más\""
    }
  ],
  "presets": [
